# Copy this file to ".env" (same folder) and fill in what you have.
# start.bat / start.sh load it automatically — no PowerShell env vars needed.
# .env is gitignored; your keys never get committed or pushed.

# ---- Pick ONE free provider (checked in this order if more than one is set) ----
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Optional: Claude, for the highest writing quality (~10-15 cents/resume) ----
# Leave blank to use only the free provider above. Force Claude for one run with
# RESUME_PROVIDER=anthropic even if a free key above is also set.
ANTHROPIC_API_KEY=

# ---- Optional: job search sources (Find Jobs tab) ----
# JSearch (rapidapi.com/search/jsearch, free tier) — best for "posted in the last hour"
JSEARCH_API_KEY=
# Adzuna (developer.adzuna.com, free) — adds US/local on-site boards + salary data
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Optional: only needed if you deploy this for friends to share ----
# APP_PASSWORD=

# Copy this file to ".env" (same folder) and fill in what you have.
# start.bat / start.sh load it automatically — no PowerShell env vars needed.
# .env is gitignored; your keys never get committed or pushed.

# ---- Pick ONE free provider (checked in this order if more than one is set) ----
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Optional: Claude, for the highest writing quality (~10-15 cents/resume) ----
# Leave blank to use only the free provider above. Force Claude for one run with
# RESUME_PROVIDER=anthropic even if a free key above is also set.
ANTHROPIC_API_KEY=

# ---- Optional: job search sources (Find Jobs tab) ----
# JSearch (rapidapi.com/search/jsearch, free tier) — best for "posted in the last hour"
JSEARCH_API_KEY=
# Adzuna (developer.adzuna.com, free) — adds US/local on-site boards + salary data
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble (jooble.org/api/about, free key by email request) — big Indeed-style aggregator
JOOBLE_API_KEY=
# Findwork (findwork.dev/developers/api, free) — developer jobs, date-sorted
FINDWORK_API_KEY=

# ---- Optional: only needed if you deploy this for friends to share ----
# APP_PASSWORD=
# Max AI runs (tailor/check/cover) per person per hour, so nobody can burn the
# shared LLM quota in a loop. Default 30. Set 0 to disable (fine when solo).
# RESUME_RATE_LIMIT=30

# ---- Optional: LLM call tuning (defaults are usually fine) ----
# Per-call timeout in seconds. A tailor run makes several sequential LLM
# calls (write, score, revisions); each one is bounded to this long with no
# silent SDK retries, so a slow free-tier provider fails fast and clearly
# instead of hanging for minutes. Raise this if you're on a known-slow
# provider and would rather wait longer than get a timeout error.
# RESUME_LLM_TIMEOUT=45
# How many extra revise+rescore passes to run when the score is below 85%.
# Each pass adds 1-2 more LLM calls to the total run time. Default is 1 for
# speed; raise it (e.g. 2) if you're on a fast/paid provider and want more
# polishing attempts.
# RESUME_MAX_REVISIONS=1
